{
  "name": "realmgate-ar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Realmgate: a multiplayer AR action RPG prototype for phones (WebXR + three.js).",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:server\" \"vite --host\"",
    "client": "vite --host",
    "server": "node server/server.js",
    "build": "vite build",
    "start": "vite build && node server/server.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "three": "^0.185.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "concurrently": "^9.1.0",
    "vite": "^7.0.0"
  }
}
